# Postgres connection string (Neon). In production on Vercel this is injected
# automatically once you add the Neon integration from the Storage tab --
# you don't need to set it by hand there.
#
# For local development, either point this at a Neon branch (e.g. run
# `npx vercel env pull .env.development.local` after linking the project),
# or at any local Postgres instance:
DATABASE_URL=postgres://user:password@localhost:5432/worktracker

PORT=4000
